# ---------------------------------------------------------------------------
# Banco de dados
#
# SQLite local: um arquivo, sem servidor e sem credencial.
# Ao migrar para Supabase/Postgres, troque por algo como
#   DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"
# e mude o `provider` em prisma/schema.prisma e o adaptador em
# src/infrastructure/db/prisma.ts.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Segredo de assinatura dos tokens de sessão (JWT HS256).
#
# Mínimo de 32 caracteres. Em produção é obrigatório — a aplicação recusa subir
# sem ele. Gere um novo com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Trocar este valor invalida todas as sessões abertas.
# ---------------------------------------------------------------------------
AUTH_SECRET=""

# Senha dos usuários criados por `npm run db:seed`. Só afeta a carga inicial.
# SEED_PASSWORD="solint2026"
