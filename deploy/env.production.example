# .env de produção da VM. Copie para a raiz do projeto como `.env`:
#
#   cp deploy/env.production.example .env && chmod 600 .env && nano .env
#
# Sem aspas nos valores: o compose repassa o texto como está.
# NUNCA versione o arquivo preenchido (o .gitignore já barra `.env`).

# --------------------------------------------------------------- endereço
# IP da VM com hífens + .sslip.io (ou o domínio definitivo, quando houver).
SITE_ADDRESS=129-146-10-20.sslip.io
SOLINT_APP_URL=https://129-146-10-20.sslip.io

# --------------------------------------------------------------- banco
# Gere com: openssl rand -hex 24   (só hex: entra na URL sem escapar nada)
POSTGRES_PASSWORD=TROQUE
# As três apontam para o mesmo Postgres local. Sem pooler, sem os cuidados
# das seções 1 a 3 do .env.example — isso era do Supabase.
DATABASE_URL=postgresql://solint:TROQUE@postgres:5432/solint?connection_limit=10
DIRECT_URL=postgresql://solint:TROQUE@postgres:5432/solint
WORKER_DATABASE_URL=postgresql://solint:TROQUE@postgres:5432/solint?connection_limit=10

# --------------------------------------------------------------- segredos
# Traga os MESMOS valores de hoje (painel do Render, serviço do worker).
#
# WA_ENCRYPTION_KEY cifra as credenciais do WhatsApp guardadas no banco. Com
# outra chave, as sessões migradas ficam ilegíveis e toda caixa pede QR de
# novo. AUTH_SECRET diferente só desloga todo mundo uma vez.
AUTH_SECRET=
WA_ENCRYPTION_KEY=

# --------------------------------------------------------------- mídia
# PAR de leitura e gravação do bucket de mídia (termina em /o/).
OBJECT_STORAGE_PAR_URL=
# PAR SÓ DE GRAVAÇÃO do bucket de backups, usada por deploy/backup.sh.
BACKUP_PAR_URL=

# --------------------------------------------------------------- aplicação
NODE_ENV=production
WA_ENGINE=worker
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo
WA_LOG_LEVEL=info
