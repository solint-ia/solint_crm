// Esquema de persistência do Solint CRM.
//
// Postgres (Supabase). O SQLite foi o degrau: um arquivo local, sem credencial,
// que permitiu construir a persistência antes de existir banco hospedado. A
// troca custou o `provider` aqui, o adaptador em `infrastructure/db/prisma.ts`
// e 26 colunas de `String` para `Json` — nenhuma linha de domínio, caso de uso
// ou tela mudou.
//
// Duas restrições do SQLite moldaram o desenho original, e vale registrar o que
// aconteceu com cada uma:
//
//   1. Não havia `enum`  -> todo estado de domínio é `String`, validado no
//      domínio. **Continua assim de propósito.** Postgres tem `enum`, mas cada
//      valor novo viraria um `ALTER TYPE`, e o domínio já valida.
//   2. Não havia `Json`  -> agregados eram `String` com JSON dentro. **Resolvido:**
//      são `Json` nativo. Além de honesto, agora dá para consultar dentro do
//      agregado (`content->>'kind'`), o que era impossível quando era texto.
//
// A regra de corte entre coluna relacional e coluna JSON: **é relacional o que
// se consulta, filtra ou escreve individualmente**. É JSON o agregado que só é
// lido e gravado inteiro (o horário comercial de uma caixa, as regras de
// transferência de um agente, o histórico de um card). Normalizar esses
// últimos criaria dez tabelas que nenhuma consulta jamais tocaria sozinhas.
//
// Essa regra tem gatilho: quando um agregado ganha escrita individual, vira
// tabela. A Onda 3 dispara isso para `Team`, `Webhook`, `ApiToken`,
// `CustomAttribute`, `CannedResponse`, `Macro` e `AuditLog` — ver a Fase 5 do
// PLANO-BACKEND.md.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// O Prisma 7 tirou a `url` daqui: a conexão vem de `prisma.config.ts` (CLI, que
// lê DIRECT_URL) e do adaptador passado ao `PrismaClient` (runtime, DATABASE_URL).
// São URLs diferentes de propósito — ver .env.example.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- conta e acesso

model Account {
  id       String  @id
  name     String
  plan     String
  document String?

  createdAt DateTime @default(now())

  memberships      Membership[]
  roles            Role[]
  labels           Label[]
  contacts         Contact[]
  conversations    Conversation[]
  pipelines        Pipeline[]
  deals            Deal[]
  aiAgents         AiAgent[]
  notifications    Notification[]
  automations      Automation[]
  inboxes          Inbox[]
  categories       KnowledgeCategory[]
  articles         KnowledgeArticle[]
  settings         AccountSettings?
  teams            Team[]
  webhooks         Webhook[]
  apiTokens        ApiToken[]
  customAttributes CustomAttributeDefinition[]
  cannedResponses  CannedResponse[]
  macros           Macro[]
  auditLogs        AuditLogEntry[]
  campaigns        Campaign[]
  segments         Segment[]
  messageTemplates MessageTemplate[]
  invites          Invite[]
  tasks            Task[]
  mediaObjects     MediaObject[]
  scheduledMessages ScheduledMessage[]
}

/// A pessoa. Nada aqui é específico de uma conta — o que é, mora em `Membership`.
model User {
  id               String  @id
  name             String
  /// Identidade de login, global. Guardado em minúsculas para a busca ser
  /// case-insensitive. É único no sistema inteiro, e não por conta: a pessoa é
  /// uma só mesmo quando atende em dois workspaces.
  email            String  @unique
  /// `scrypt` com sal por usuário. A senha em claro nunca é gravada nem logada.
  passwordHash     String
  avatarTone       String
  /// URL servida por `/api/users/[userId]/avatar`, com o tipo do arquivo e uma
  /// versão embutidos na própria query string (`?t=<mimeType>&v=<timestamp>`).
  ///
  /// Não há coluna separada para o tipo: a URL inteira é o contrato entre quem
  /// grava e quem serve. O `v` muda a cada envio para que o navegador nunca
  /// sirva, do próprio cache, uma foto que a pessoa acabou de trocar — sem ele,
  /// o `<img>` continuaria apontando para o mesmo endereço de sempre e trocar a
  /// foto pareceria não ter feito nada.
  avatarUrl        String?
  signature        String?
  /// A assinatura vai ou não vai junto com o que a pessoa escreve.
  ///
  /// Separado do texto porque desligar não é apagar: quem tira a assinatura por
  /// uma semana não deveria ter de reescrevê-la depois. O padrão é `false`
  /// porque ligar isto muda o que o cliente recebe — uma linha a mais em toda
  /// mensagem —, e essa não é uma decisão para tomar em nome de ninguém.
  signatureEnabled Boolean @default(false)
  /// JSON: NotificationPreferences — avisos pessoais e som.
  notificationPrefs Json?
  twoFactorEnabled Boolean @default(false)
  lastActiveAt     String?
  /// Administra webhooks e tokens de API de QUALQUER conta, pela área
  /// `/plataforma`, fora do isolamento por tenant do resto do sistema.
  ///
  /// Mora aqui, e não em `Membership`/`Role`, porque a capacidade é da pessoa e
  /// não de um vínculo com uma conta — quem administra a integração de todas as
  /// contas não é membro de nenhuma delas em particular. Ver
  /// REGRAS-GLOBAIS.md §4.4: esta é a única exceção deliberada e documentada ao
  /// isolamento multi-tenant, e mesmo ela continua consultando o banco sempre
  /// escopada por `accountId` — o que muda é quem pode fazer a pergunta.
  isSuperAdmin     Boolean @default(false)

  createdAt DateTime @default(now())

  memberships    Membership[]
  authSessions   AuthSession[]
  conversations  Conversation[]
  notifications  Notification[]
  assignedTasks   Task[]       @relation("TaskAssignee")
  createdInvites  Invite[]     @relation("InviteCreator")
  teamMemberships TeamMember[]
}

/// Vínculo entre uma pessoa e uma conta — "este usuário, neste workspace".
///
/// Existe porque três campos que estavam em `User` são, na verdade, propriedades
/// do vínculo e não da pessoa: o **papel** (alguém pode ser administrador aqui e
/// colaborador ali), as **equipes** (Comercial de uma conta não é a Comercial de
/// outra) e a **disponibilidade** (dá para estar em atendimento num workspace e
/// fora em outro). Mantê-los em `User` fazia o segundo workspace herdar o
/// primeiro em silêncio.
///
/// O `Session` do domínio continua vendo um `User` com `accountId` e `roleSlug`:
/// ele é montado a partir da pessoa mais o vínculo da conta ativa.
model Membership {
  id        String @id @default(cuid())
  userId    String
  accountId String

  /// Aponta para `Role.slug` dentro desta conta. Não é chave estrangeira de
  /// propósito: papel apagado deve virar "sem permissão", e não impedir a
  /// exclusão do papel nem apagar o vínculo em cascata.
  roleSlug     String
  availability String @default("disponivel")

  /// Personalização de permissões **desta pessoa**, sobre o papel dela.
  ///
  /// JSON: `PermissionOverrides` — `{ add: Permission[], remove: Permission[] }`.
  /// `null` significa "segue o papel exatamente", que é o caso da maioria.
  ///
  /// Guardado como diferença, e não como lista fechada, para a pessoa continuar
  /// acompanhando o papel em tudo que não foi explicitamente mexido: uma lista
  /// fechada seria uma fotografia do papel no dia da gravação, e divergiria em
  /// silêncio a cada edição posterior do papel. Ver `effectivePermissions()`.
  permissionOverrides Json?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
}

/// Sessão emitida. Existe para que "sair de todas as sessões" seja possível:
/// um JWT sem registro é irrevogável até expirar.
model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  /// `jti` do token. É o que a verificação confere contra a revogação.
  tokenId   String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String  @id
  accountId   String
  slug        String
  name        String
  description String
  /// JSON: Permission[]
  permissions Json
  isSystem    Boolean @default(false)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, slug])
}

// ---------------------------------------------------------------- etiquetas

model Label {
  id          String  @id
  accountId   String
  name        String
  tone        String
  description String?
  usageCount  Int?

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts      Contact[]      @relation("ContactLabels")
  conversations Conversation[] @relation("ConversationLabels")
  stages        PipelineStage[]

  @@index([accountId])
}

// ---------------------------------------------------------------- contatos

model Contact {
  id               String  @id
  accountId        String
  name             String
  /// E.164. Vazio quando `kind = grupo` — um grupo não tem telefone próprio.
  ///
  /// É o número por onde as conversas saem. Continua sendo **um**: uma conversa
  /// tem um destinatário, e escolher sozinho qual dos números usar seria decidir
  /// no lugar de quem atende.
  phone            String
  /// Outros números da mesma pessoa, em E.164, sem repetir o de `phone`.
  ///
  /// Nasce das importações de prospecção, onde a mesma pessoa aparece em várias
  /// linhas — uma por telefone. Guardar cada linha como um contato separado
  /// criava três "THIAGO FRANKLIN PROENCA" na agenda, e quem abrisse um deles
  /// não tinha como saber que os outros dois eram a mesma pessoa.
  extraPhones      String[] @default([])
  email            String?
  company          String?
  channel          String
  avatarTone       String
  location         String?
  timezone         String?
  ownerName        String?
  lastContactAt    String?
  lastContactLabel String?
  /// JSON: CustomField[]
  customFields     Json    @default("[]")
  notes            String?
  /// JSON: TimelineEvent[]
  timeline         Json    @default("[]")
  kind             String? @default("pessoa")
  avatarUrl        String?
  participantCount Int?

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  labels             Label[]             @relation("ContactLabels")
  conversations      Conversation[]
  campaignRecipients CampaignRecipient[]

  @@index([accountId])
}

// ---------------------------------------------------------------- conversas

model Conversation {
  id                 String    @id
  accountId          String
  contactId          String
  channel            String
  inboxId            String
  queue              String
  status             String
  statusLabel        String
  /// Quando a conversa nasceu. É o início de toda janela de período do
  /// painel: sem ela, "últimos 7 dias" só conseguia contar a conversa pela
  /// última atividade -- uma conversa de março respondida ontem entrava como
  /// conversa de ontem.
  createdAt          DateTime  @default(now())
  /// Primeiro retorno de um atendente após a primeira mensagem do cliente.
  firstResponseAt    DateTime?
  /// O mesmo em segundos, já calculado. Guardado porque o painel agrega
  /// milhares de conversas por período e refazer a conta a cada leitura
  /// exigiria varrer a tabela de mensagens inteira.
  firstResponseSecs  Int?
  /// Quando passou a "resolvida" pela última vez.
  resolvedAt         DateTime?
  /// Da criação até a resolução, em segundos.
  resolutionSecs     Int?
  /// Nota de satisfação dada pelo cliente, de 1 a 5. Nulo = não avaliou.
  csatScore          Int?
  csatComment        String?
  /// Quando a pergunta de satisfação saiu -- a resposta seguinte do cliente
  /// é lida como nota enquanto esta marca estiver dentro da janela.
  csatAskedAt        DateTime?
  csatAnsweredAt     DateTime?
  priority           String    @default("baixa")
  assigneeId         String?
  assigneeName       String?
  unreadCount        Int       @default(0)
  lastMessagePreview String    @default("")
  /// Rótulo de exibição ("14:32"). Nunca use para ordenar.
  lastMessageAt      String    @default("")
  /// Instante real da última atividade — a única fonte de ordenação.
  lastActivityAt     DateTime?
  /// JSON: Protocol[]
  protocols          Json      @default("[]")
  slaDeadlineAt      String?
  slaLabel           String?
  slaBreached        Boolean?
  isTyping           Boolean?
  collisionAgent     String?
  lastInboundAt      String?
  channelOffline     Boolean?
  /// JID do WhatsApp. É o destino canônico de envio.
  channelThreadId    String?

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  inbox    Inbox     @relation(fields: [inboxId],   references: [id], onDelete: Restrict)
  assignee User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  labels   Label[]   @relation("ConversationLabels")
  messages Message[]
  scheduledMessages ScheduledMessage[]

  @@unique([inboxId, channelThreadId])
  @@index([accountId, lastActivityAt])
  /// O painel recorta por janela de tempo, sempre a partir da criação.
  @@index([accountId, createdAt])
  /// A varredura da mensagem de espera procura por conversa parada em aberto.
  @@index([status, lastInboundAt])
  @@index([contactId])
}

model Message {
  id             String   @id
  conversationId String
  author         String
  /// Usuário do CRM que enviou a mensagem; nulo para contato/sistema.
  authorId       String?
  authorName     String?
  /// Tipo do conteúdo, duplicado fora do JSON para permitir consulta por mídia.
  contentType    String
  /// JSON: MessageContent
  content        Json
  /// Rótulo de exibição ("14:32").
  time           String
  /// Instante real. É daqui que saem os divisores de dia da timeline.
  createdAt      DateTime @default(now())
  deliveryStatus String?
  isPrivate      Boolean  @default(false)
  /// Mensagem citada. Guarda o `Message.id`, não o id do canal: é por ele que a
  /// timeline encontra o original para desenhar a citação.
  replyToId      String?
  /// Quando a mensagem foi apagada. A linha continua: a timeline precisa do
  /// buraco no lugar certo ("Mensagem apagada"), como o próprio WhatsApp faz.
  /// Apagar a linha reordenaria o histórico e quebraria as citações que a
  /// apontam.
  deletedAt      DateTime?
  externalId     String?
  origin         String?
  /// JSON: MessageReaction[] — as reações (emoji) que esta mensagem recebeu.
  ///
  /// Coluna JSON e não tabela própria porque a reação não tem vida sem a
  /// mensagem: ela nasce, é substituída e morre junto, nunca é consultada
  /// isoladamente e o WhatsApp permite **uma** por pessoa. Uma tabela custaria
  /// um `join` em toda leitura de timeline para modelar um campo.
  reactions      Json     @default("[]")
  /// JID de quem escreveu, quando a mensagem veio de um grupo.
  ///
  /// Fora de grupo é redundante (o autor é o dono da conversa) e fica nulo. Em
  /// grupo é indispensável para **reagir**: a chave que o WhatsApp exige para
  /// apontar uma mensagem de terceiro carrega o participante, e sem ele o
  /// servidor recusa a reação.
  senderJid      String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Deduplicacao por construcao, e nao por sorte de agendamento.
  ///
  /// O WhatsApp reentrega eventos. Antes a checagem era consulta seguida de
  /// insercao -- duas operacoes com uma janela entre elas. A escrita serializada
  /// do SQLite escondia a corrida; em Postgres, dois eventos concorrentes viram
  /// mensagem duplicada na tela. Com o unico, o `upsert` resolve no banco.
  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([authorId])
  /// Recibo de entrega chega com o id do canal e mais nada.
  ///
  /// `applyDeliveryUpdate` procura por `externalId` sozinho, e o único índice
  /// que o continha era o composto com `conversationId` na frente — inútil para
  /// esta busca, porque o Postgres não consegue partir da segunda coluna. Cada
  /// recibo virava varredura da tabela inteira, e o WhatsApp manda um por
  /// mensagem entregue e outro por mensagem lida.
  @@index([externalId])
}

// ---------------------------------------------------------------- funil

model Pipeline {
  id        String  @id
  accountId String
  name      String
  isDefault Boolean @default(false)

  /// A caixa de entrada a que este funil pertence.
  ///
  /// `null` = funil avulso, não ligado a conexão nenhuma. É o estado de todos
  /// os funis criados antes desta coluna existir, e continua sendo válido: um
  /// funil que atravessa canais é uma escolha legítima do cliente.
  ///
  /// `onDelete: SetNull` e não `Cascade`: excluir uma conexão do WhatsApp já
  /// apaga conversas e mensagens daquela caixa, e levar junto o histórico
  /// comercial — negócios ganhos, valores fechados — seria uma perda de outra
  /// natureza, que ninguém pediu ao clicar em "excluir caixa". O funil vira
  /// avulso em vez de desaparecer.
  inboxId String?
  inbox   Inbox?  @relation(fields: [inboxId], references: [id], onDelete: SetNull)

  account Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stages  PipelineStage[]
  deals   Deal[]

  @@index([accountId])
  @@index([inboxId])
}

model PipelineStage {
  id         String  @id
  pipelineId String
  name       String
  order      Int
  color      String
  isWon      Boolean @default(false)
  isLost     Boolean @default(false)
  /// Quanto esta etapa representa de conversão, de 0 a 100.
  conversionWeight Int @default(0)
  /// Etiqueta que representa esta etapa no cadastro do contato.
  ///
  /// É o elo entre o funil e as etiquetas: arrastar um card para cá aplica
  /// esta etiqueta ao contato e tira a da etapa de origem, e um contato que
  /// perde a última etiqueta ligada a alguma etapa sai do quadro. Nulo quando
  /// a etapa não espelha etiqueta nenhuma — o card então só se move na mão.
  labelId String?

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  label    Label?   @relation(fields: [labelId], references: [id], onDelete: SetNull)
  deals    Deal[]

  @@index([pipelineId])
  @@index([labelId])
}

model Deal {
  id             String  @id
  accountId      String
  pipelineId     String
  stageId        String
  contactId      String?
  contactName    String
  company        String?
  /// Como a oportunidade se chama no quadro. Nulo cai em `contactName`.
  ///
  /// A modal de nova oportunidade sempre pediu este campo, e ele morria no
  /// caminho: o repositório o usava para compor o texto do histórico e para
  /// preencher `contactName` quando não havia contato, e nunca o gravava. A
  /// busca do Kanban procurava por `deal.title`, um campo que jamais existiu.
  title          String?
  /// De onde o negócio veio (`DealSource`). Nulo = não declarada.
  ///
  /// O `<select>` de origem existia na modal e na barra de filtros desde
  /// sempre; sem coluna, o filtro não casava com card nenhum.
  source         String?
  /// Centavos. Dinheiro nunca é float.
  amountInCents  Int
  ownerName      String
  priority       String    @default("baixa")
  /// Quando o card nasceu.
  ///
  /// Distinto de `enteredStageAt`, que é a entrada na **etapa atual** e muda a
  /// cada arrasto. Sem esta coluna, o filtro "Criados hoje" do quadro respondia
  /// pela data do último movimento — um card de março movido hoje entrava como
  /// criado hoje.
  createdAt      DateTime @default(now())
  enteredStageAt String
  stageAgeLabel  String
  nextAction     String
  conversationId String?
  /// JSON: DealHistoryEntry[]
  history        Json    @default("[]")

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([accountId, pipelineId])
  @@index([stageId])
  /// O filtro de período do quadro recorta por criação, dentro da conta.
  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------- agentes de IA

model AiAgent {
  id            String  @id
  accountId     String
  name          String
  scope         String
  active        Boolean @default(false)
  persona       String
  systemPrompt  String
  model         String
  handledCount  Int     @default(0)
  transferRate  String
  /// JSON: KnowledgeDocument[]
  knowledgeBase Json    @default("[]")
  /// JSON: TransferRule[]
  transferRules Json    @default("[]")
  /// JSON: AgentFlowBlock[]
  flow          Json    @default("[]")
  /// JSON: AiAgentLog[]
  logs          Json    @default("[]")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ---------------------------------------------------------------- notificações

model Notification {
  id        String   @id
  accountId String
  /// Nulo = aviso da conta inteira, visível para todos os agentes.
  userId    String?
  kind      String
  text      String
  timeLabel String
  read      Boolean  @default(false)
  href      String?
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, userId])
}

// ---------------------------------------------------------------- configurações

model Automation {
  id         String  @id
  accountId  String
  name       String
  trigger    String
  /// JSON: AutomationCondition[]
  conditions Json    @default("[]")
  /// Como as condições se combinam: `e` (todas) ou `ou` (qualquer uma).
  /// O padrão repete o comportamento anterior ao campo, quando a lista era
  /// sempre avaliada com `every`.
  conditionLogic String @default("e")
  /// JSON: AutomationAction[]
  actions    Json    @default("[]")
  enabled    Boolean @default(true)
  /// Decide quem vence um conflito de sobrescrita.
  order      Int

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, order])
}

model Inbox {
  id            String  @id
  accountId     String
  name          String
  channel       String
  identifier    String
  status        String
  provider      String
  teamName      String?
  /// JSON: BusinessHours
  businessHours Json
  /// JSON: AutoReply
  awayMessage   Json
  /// JSON: AutoReply
  greeting      Json
  /// JSON: AutoReply
  closingMessage Json?
  /// JSON: AutoReply
  waitingMessage Json?
  /// Minutos de fila sem resposta antes de a mensagem de espera sair.
  waitingMessageDelayMinutes Int @default(5)
  /// Pergunta a nota de 1 a 5 ao cliente quando o atendimento é encerrado.
  csatEnabled   Boolean @default(false)
  csatQuestion  String?
  webhookUrl    String?

  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  waConnection  WhatsAppConnection?
  campaigns     Campaign[]
  mediaObjects  MediaObject[]
  teamInboxes   TeamInbox[]
  pipelines     Pipeline[]

  @@index([accountId])
}

/// Estado de uma sessão Baileys. Existe por caixa de entrada, não por conta:
/// uma conta com três números tem três linhas aqui, cada uma com socket próprio.
model WhatsAppConnection {
  inboxId String @id

  /// JID do número pareado. Nulo até o QR ser lido.
  phoneJid        String?
  profileName     String?
  /// Quem do CRM pareou. É o dono operacional do canal.
  pairedByUserId  String?
  status          String    @default("desconectado")
  lastError       String?
  lastConnectedAt DateTime?
  /// String do QR em pareamento.
  qrPayload       String?
  qrExpiresAt     DateTime?
  /// Contador de tentativas — evita loop de reconexão infinito após ban.
  retryCount      Int       @default(0)

  /// `creds.json` do Baileys, cifrado com AES-256-GCM.
  credsCipher Bytes?
  credsIv     Bytes?
  credsTag    Bytes?

  /// Trava de posse: só o worker que gravou este id pode abrir o socket.
  lockOwner     String?
  lockExpiresAt DateTime?

  updatedAt DateTime @updatedAt

  inbox Inbox         @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  keys  WhatsAppKey[]
}

/// Material criptográfico de sessão. Milhares de linhas pequenas por conexão,
/// gravadas em lote. Separado de `WhatsAppConnection` porque o perfil de escrita
/// é o oposto: `creds` é raro e crítico; isto é frequente e reconstituível.
model WhatsAppKey {
  inboxId  String
  /// pre-key | session | sender-key | app-state-sync-key | app-state-sync-version | sender-key-memory
  category String
  keyId    String

  valueCipher Bytes
  valueIv     Bytes
  valueTag    Bytes

  updatedAt DateTime @updatedAt

  connection WhatsAppConnection @relation(fields: [inboxId], references: [inboxId], onDelete: Cascade)

  @@id([inboxId, category, keyId])
  @@index([inboxId, category])
  /// Expiração do material de cache (`lid-mapping`, `tctoken`).
  ///
  /// A faxina horária procura por categoria e idade, e o índice acima começa
  /// por `inboxId` — inútil para essa varredura. Sem este, a limpeza leria a
  /// tabela inteira a cada hora, e ela é justamente a que mais cresce.
  @@index([category, updatedAt])
}

/// Fila de comandos assíncronos enviados pelo Next.js para o Worker de WhatsApp.
model WhatsAppCommand {
  id        String   @id @default(cuid())
  inboxId   String
  kind      String   // connect | disconnect | send | read
  payload   Json     @default("{}")
  status    String   @default("pending") // pending | processing | completed | failed
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inboxId, status])
  @@index([status, createdAt])
}

model KnowledgeCategory {
  id          String @id
  accountId   String
  name        String
  description String
  order       Int

  account  Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  articles KnowledgeArticle[]

  @@index([accountId])
}

model KnowledgeArticle {
  id           String @id
  accountId    String
  categoryId   String
  title        String
  slug         String
  excerpt      String
  content      String
  status       String
  updatedLabel String
  authorName   String
  views        Int    @default(0)
  helpful      Int    @default(0)
  notHelpful   Int    @default(0)
  /// JSON: string[]
  tags         Json   @default("[]")

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([accountId, categoryId])
}

/// Configurações gerais da conta.
model AccountSettings {
  accountId        String @id
  assignmentMethod String @default("round_robin")
  /// JSON: BillingInfo
  billing          Json
  /// JSON: ActiveSession[]
  activeSessions   Json   @default("[]")
  /// JSON: CompanyProfile — razão social, endereço, preferências regionais e marca.
  ///
  /// É JSON pela regra do topo deste arquivo: o perfil é lido e gravado
  /// inteiro pela tela de empresa, e nenhuma consulta filtra por endereço ou
  /// formato de data. `name` e `document` continuam colunas de `Account`,
  /// porque esses dois são consultados de fato.
  company          Json   @default("{}")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- Onda 3: Entidades Relacionais Normalizadas

model Team {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  description String?
  color       String
  createdAt   DateTime @default(now())

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  teamMembers TeamMember[]
  teamInboxes TeamInbox[]

  @@index([accountId])
}

/// Pessoa que pertence a uma equipe.
///
/// Substituiu dois campos `Json` que guardavam a mesma relação em direções
/// opostas: `Team.members` (ids de usuário) e `Membership.teams` (nomes de
/// equipe). Duas fontes para o mesmo fato saem de sincronia — atualiza-se uma e
/// esquece-se a outra —, e quando o fato é "quem alcança esta caixa de
/// entrada", sair de sincronia significa mostrar conversa de cliente para quem
/// não deveria vê-la.
///
/// Sem `accountId` de propósito: o vínculo é escopado pelo `Team`, que já o tem.
/// Duplicá-lo aqui criaria uma terceira cópia do mesmo fato — exatamente o que
/// esta tabela existe para eliminar.
model TeamMember {
  teamId String
  userId String

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

/// Caixa de entrada que uma equipe alcança.
///
/// É a tabela que decide o que cada pessoa enxerga na caixa de entrada. Uma
/// caixa pode pertencer a várias equipes (a recepção e a gerência veem
/// "Atendimento"), e uma pessoa em várias equipes enxerga a união das caixas.
model TeamInbox {
  teamId  String
  inboxId String

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@id([teamId, inboxId])
  @@index([inboxId])
}

model Webhook {
  id              String    @id @default(cuid())
  accountId       String
  name            String
  url             String
  /// JSON: string[] (eventos escutados)
  events          Json      @default("[]")
  secret          String?
  isActive        Boolean   @default(true)
  failureCount    Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model ApiToken {
  id          String    @id @default(cuid())
  accountId   String
  name        String
  /// SHA-256 do token
  tokenHash   String    @unique
  tokenPrefix String
  /// JSON: string[] (permissões concedidas)
  permissions Json      @default("[]")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model CustomAttributeDefinition {
  id         String   @id @default(cuid())
  accountId  String
  /// contact | deal
  target     String
  name       String
  key        String
  /// text | number | select | date | boolean
  type       String
  /// JSON: string[] (opções para tipo select)
  options    Json     @default("[]")
  isRequired Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, target, key])
  @@index([accountId, target])
}

model CannedResponse {
  id         String   @id @default(cuid())
  accountId  String
  shortcut   String
  content    String
  category   String?
  /// JSON: string[]
  tags       Json     @default("[]")
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, shortcut])
  @@index([accountId])
}

model Macro {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  description String?
  category    String?
  shortcut    String?
  /// JSON: MacroAction[]
  actions     Json     @default("[]")
  createdAt   DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model AuditLogEntry {
  id         String   @id @default(cuid())
  accountId  String
  actorId    String
  actorName  String
  action     String
  targetType String
  targetId   String?
  targetName String?
  ip         String?
  userAgent  String?
  /// JSON: metadata
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([createdAt])
  @@index([accountId, action, createdAt])
}

model Campaign {
  id          String    @id @default(cuid())
  accountId   String
  inboxId     String
  name        String
  channel     String
  /// draft | scheduled | running | paused | completed | canceled
  status      String    @default("draft")
  segmentId   String?
  templateId  String?
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  /// JSON: CampaignStats
  stats       Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inbox      Inbox               @relation(fields: [inboxId], references: [id], onDelete: Restrict)
  segment    Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  template   MessageTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([accountId, status])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  contactId   String?
  phone       String
  name        String?
  /// JSON: variables
  variables   Json      @default("{}")
  /// queued | sent | delivered | read | replied | failed
  status      String    @default("queued")
  externalId  String?
  error       String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  repliedAt   DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([externalId])
}

model Segment {
  id           String   @id @default(cuid())
  accountId    String
  name         String
  description  String?
  /// JSON: SegmentFilter[]
  filters      Json     @default("[]")
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([accountId])
}

/// Mensagem escrita agora para sair depois.
///
/// Vive numa tabela própria — e não como uma `Message` com data futura — porque
/// enquanto não sai ela **não é** uma mensagem: não aparece na timeline, não
/// conta como não lida, não entra no resumo da conversa e pode ser cancelada
/// sem deixar buraco. Gravá-la junto das outras obrigaria toda leitura de
/// conversa a lembrar de filtrar o futuro, e a primeira que esquecesse mostraria
/// ao operador uma mensagem que o cliente nunca recebeu.
///
/// Quem executa é o mesmo processo que fala com o WhatsApp (ver
/// `scheduled-runner.ts`): o disparo precisa de um processo vivo com relógio, e
/// no serverless não existe nenhum.
model ScheduledMessage {
  id             String    @id @default(cuid())
  accountId      String
  conversationId String
  /// Caixa **da conversa** no momento do agendamento. O envio sai por ela.
  inboxId        String
  /// Quem agendou — é o autor que a mensagem terá quando sair.
  userId         String
  userName       String
  text           String
  isPrivate      Boolean   @default(false)
  /// Mensagem citada, quando o agendamento nasceu de uma resposta.
  replyToId      String?
  scheduledFor   DateTime
  /// pending | sent | canceled | failed
  status         String    @default("pending")
  error          String?
  /// Id da `Message` criada quando o agendamento saiu.
  messageId      String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// O varredor pergunta sempre a mesma coisa: o que está pendente e já venceu.
  @@index([status, scheduledFor])
  @@index([conversationId, status])
  @@index([accountId, status])
}

model MessageTemplate {
  id                 String   @id @default(cuid())
  accountId          String
  name               String
  category           String
  language           String   @default("pt_BR")
  body               String
  headerType         String?
  headerContent      String?
  footer             String?
  /// JSON: TemplateButton[]
  buttons            Json     @default("[]")
  /// JSON: string[]
  variables          Json     @default("[]")
  /// approved | rejected | pending
  status             String   @default("approved")
  externalTemplateId String?
  createdAt          DateTime @default(now())

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([accountId, name, language])
  @@index([accountId])
}

/// Tabela sem uso desde que o acesso passou a ser criado pelo gestor.
///
/// O convite por link foi substituído: o gestor cria a conta do colaborador
/// com e-mail e senha, e pode trocar as duas depois (ver
/// `createCollaboratorAction`). O modelo continua aqui porque derrubá-lo é uma
/// migração destrutiva sem nada a ganhar — a tabela está vazia e não custa
/// nada. Se um fluxo de convite voltar, ele encontra o desenho pronto.
model Invite {
  id              String    @id @default(cuid())
  accountId       String
  email           String
  roleSlug        String
  /// JSON: string[] — equipes que o convidado assume ao aceitar. É aqui que o
  /// gestor decide, no momento do convite, quais caixas a pessoa vai alcançar.
  teamIds         Json      @default("[]")
  tokenHash       String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InviteCreator", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([email])
}

model Task {
  id          String    @id @default(cuid())
  accountId   String
  dealId      String?
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  assigneeId  String?
  priority    String    @default("media")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account  Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deal     Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([accountId, completed, dueDate])
  @@index([dealId])
}

model MediaObject {
  id         String   @id @default(cuid())
  accountId  String
  inboxId    String?
  bucketPath String   @unique
  mimeType   String
  fileName   String?
  sizeBytes  Int
  checksum   String?
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inbox   Inbox?  @relation(fields: [inboxId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
}
