// Esquema de persistência do Solint CRM.
//
// Postgres (Supabase). O SQLite foi o degrau: um arquivo local, sem credencial,
// que permitiu construir a persistência antes de existir banco hospedado. A
// troca custou o `provider` aqui, o adaptador em `infrastructure/db/prisma.ts`
// e 26 colunas de `String` para `Json` — nenhuma linha de domínio, caso de uso
// ou tela mudou.
//
// Duas restrições do SQLite moldaram o desenho original, e vale registrar o que
// aconteceu com cada uma:
//
//   1. Não havia `enum`  -> todo estado de domínio é `String`, validado no
//      domínio. **Continua assim de propósito.** Postgres tem `enum`, mas cada
//      valor novo viraria um `ALTER TYPE`, e o domínio já valida.
//   2. Não havia `Json`  -> agregados eram `String` com JSON dentro. **Resolvido:**
//      são `Json` nativo. Além de honesto, agora dá para consultar dentro do
//      agregado (`content->>'kind'`), o que era impossível quando era texto.
//
// A regra de corte entre coluna relacional e coluna JSON: **é relacional o que
// se consulta, filtra ou escreve individualmente**. É JSON o agregado que só é
// lido e gravado inteiro (o horário comercial de uma caixa, as regras de
// transferência de um agente, o histórico de um card). Normalizar esses
// últimos criaria dez tabelas que nenhuma consulta jamais tocaria sozinhas.
//
// Essa regra tem gatilho: quando um agregado ganha escrita individual, vira
// tabela. A Onda 3 dispara isso para `Team`, `Webhook`, `ApiToken`,
// `CustomAttribute`, `CannedResponse`, `Macro` e `AuditLog` — ver a Fase 5 do
// PLANO-BACKEND.md.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// O Prisma 7 tirou a `url` daqui: a conexão vem de `prisma.config.ts` (CLI, que
// lê DIRECT_URL) e do adaptador passado ao `PrismaClient` (runtime, DATABASE_URL).
// São URLs diferentes de propósito — ver .env.example.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- conta e acesso

model Account {
  id       String  @id
  name     String
  plan     String
  document String?

  /// Último número de protocolo emitido por esta conta.
  ///
  /// O código do atendimento era `#AT-<5 dígitos aleatórios>`, e aleatório sem
  /// verificação colide: numa conta com 300 conversas por dia a colisão chega
  /// em semanas, e dois atendimentos com o mesmo número tornam o protocolo
  /// inútil para o que ele existe, que é o cliente citá-lo ao voltar.
  ///
  /// Incrementado com `UPDATE ... RETURNING`, que é atômico: duas conversas
  /// nascendo no mesmo instante recebem números diferentes sem transação.
  protocolSeq Int @default(0)

  /// `ativa`, `suspensa` ou `excluida`.
  ///
  /// Existe para que suspender e excluir uma conta não signifiquem apagar
  /// linhas. Uma conta de cliente carrega conversas, mensagens e o histórico de
  /// auditoria de todo mundo que trabalhou nela — um `DELETE` em cascata
  /// resolveria o pedido destruindo justamente a prova do que aconteceu ali,
  /// sem volta possível. Marcar é reversível; apagar não.
  ///
  /// Quem faz a marca valer é `readSession()`: uma conta fora de `ativa` deixa
  /// de resolver sessão, e as que já estavam abertas caem na requisição
  /// seguinte. A checagem mora lá, e não em cada tela, para que uma rota nova
  /// nasça protegida.
  status String @default("ativa")

  /// Libera a funcionalidade de agentes de IA para esta conta.
  ///
  /// E uma habilitacao comercial da conta, independente das permissoes dos
  /// usuarios e do estado `active` de cada agente cadastrado.
  aiAgentAccessEnabled Boolean @default(false)

  suspendedAt     DateTime?
  /// O que dizer a quem tentar entrar. Sem isto a pessoa vê uma porta fechada
  /// sem nenhuma pista de a quem recorrer.
  suspendedReason String?

  createdAt DateTime @default(now())

  memberships              Membership[]
  roles                    Role[]
  labels                   Label[]
  contacts                 Contact[]
  conversations            Conversation[]
  pipelines                Pipeline[]
  deals                    Deal[]
  aiAgents                 AiAgent[]
  notifications            Notification[]
  automations              Automation[]
  inboxes                  Inbox[]
  whatsappCloudConnections WhatsAppCloudConnection[]
  categories               KnowledgeCategory[]
  articles                 KnowledgeArticle[]
  settings                 AccountSettings?
  teams                    Team[]
  webhooks                 Webhook[]
  apiTokens                ApiToken[]
  customAttributes         CustomAttributeDefinition[]
  cannedResponses          CannedResponse[]
  macros                   Macro[]
  auditLogs                AuditLogEntry[]
  campaigns                Campaign[]
  segments                 Segment[]
  messageTemplates         MessageTemplate[]
  invites                  Invite[]
  tasks                    Task[]
  mediaObjects             MediaObject[]
  mediaBlobs               MediaBlob[]
  pendingMedia             PendingMedia[]
  addressBookNames         WhatsAppAddressBookName[]
  scheduledMessages        ScheduledMessage[]
  contactImportBatches     ContactImportBatch[]
  webhookDeliveries        WebhookDelivery[]
}

/// A pessoa. Nada aqui é específico de uma conta — o que é, mora em `Membership`.
model User {
  id                String  @id
  name              String
  /// Identidade de login, global. Guardado em minúsculas para a busca ser
  /// case-insensitive. É único no sistema inteiro, e não por conta: a pessoa é
  /// uma só mesmo quando atende em dois workspaces.
  email             String  @unique
  /// `scrypt` com sal por usuário. A senha em claro nunca é gravada nem logada.
  passwordHash      String
  /// Projeção para inspeção direta da tabela: `superadmin` quando a
  /// pessoa administra a plataforma; nos demais casos, o papel do primeiro
  /// workspace ao qual ela foi vinculada. A autorização continua usando
  /// `Membership.roleSlug`, pois uma pessoa pode ter papéis diferentes em
  /// workspaces diferentes. Triggers do banco mantêm esta coluna sincronizada.
  role              String?
  avatarTone        String
  /// URL servida por `/api/users/[userId]/avatar`, com o tipo do arquivo e uma
  /// versão embutidos na própria query string (`?t=<mimeType>&v=<timestamp>`).
  ///
  /// Não há coluna separada para o tipo: a URL inteira é o contrato entre quem
  /// grava e quem serve. O `v` muda a cada envio para que o navegador nunca
  /// sirva, do próprio cache, uma foto que a pessoa acabou de trocar — sem ele,
  /// o `<img>` continuaria apontando para o mesmo endereço de sempre e trocar a
  /// foto pareceria não ter feito nada.
  avatarUrl         String?
  signature         String?
  /// A assinatura vai ou não vai junto com o que a pessoa escreve.
  ///
  /// Separado do texto porque desligar não é apagar: quem tira a assinatura por
  /// uma semana não deveria ter de reescrevê-la depois. O padrão é `false`
  /// porque ligar isto muda o que o cliente recebe — uma linha a mais em toda
  /// mensagem —, e essa não é uma decisão para tomar em nome de ninguém.
  signatureEnabled  Boolean @default(false)
  /// JSON: NotificationPreferences — avisos pessoais e som.
  notificationPrefs Json?
  twoFactorEnabled  Boolean @default(false)
  lastActiveAt      String?
  /// Administra webhooks e tokens de API de QUALQUER conta, pela área
  /// `/plataforma`, fora do isolamento por tenant do resto do sistema.
  ///
  /// Mora aqui, e não em `Membership`/`Role`, porque a capacidade é da pessoa e
  /// não de um vínculo com uma conta — quem administra a integração de todas as
  /// contas não é membro de nenhuma delas em particular. Ver
  /// REGRAS-GLOBAIS.md §4.4: esta é a única exceção deliberada e documentada ao
  /// isolamento multi-tenant, e mesmo ela continua consultando o banco sempre
  /// escopada por `accountId` — o que muda é quem pode fazer a pergunta.
  isSuperAdmin      Boolean @default(false)

  createdAt DateTime @default(now())

  memberships     Membership[]
  authSessions    AuthSession[]
  conversations   Conversation[]
  notifications   Notification[]
  assignedTasks   Task[]         @relation("TaskAssignee")
  createdInvites  Invite[]       @relation("InviteCreator")
  teamMemberships TeamMember[]
}

/// Vínculo entre uma pessoa e uma conta — "este usuário, neste workspace".
///
/// Existe porque três campos que estavam em `User` são, na verdade, propriedades
/// do vínculo e não da pessoa: o **papel** (alguém pode ser administrador aqui e
/// colaborador ali), as **equipes** (Comercial de uma conta não é a Comercial de
/// outra) e a **disponibilidade** (dá para estar em atendimento num workspace e
/// fora em outro). Mantê-los em `User` fazia o segundo workspace herdar o
/// primeiro em silêncio.
///
/// O `Session` do domínio continua vendo um `User` com `accountId` e `roleSlug`:
/// ele é montado a partir da pessoa mais o vínculo da conta ativa.
model Membership {
  id        String @id @default(cuid())
  userId    String
  accountId String

  /// Aponta para `Role.slug` dentro desta conta. Não é chave estrangeira de
  /// propósito: papel apagado deve virar "sem permissão", e não impedir a
  /// exclusão do papel nem apagar o vínculo em cascata.
  roleSlug     String
  availability String @default("disponivel")

  /// Personalização de permissões **desta pessoa**, sobre o papel dela.
  ///
  /// JSON: `PermissionOverrides` — `{ add: Permission[], remove: Permission[] }`.
  /// `null` significa "segue o papel exatamente", que é o caso da maioria.
  ///
  /// Guardado como diferença, e não como lista fechada, para a pessoa continuar
  /// acompanhando o papel em tudo que não foi explicitamente mexido: uma lista
  /// fechada seria uma fotografia do papel no dia da gravação, e divergiria em
  /// silêncio a cada edição posterior do papel. Ver `effectivePermissions()`.
  permissionOverrides Json?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
}

/// Sessão emitida. Existe para que "sair de todas as sessões" seja possível:
/// um JWT sem registro é irrevogável até expirar.
model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  /// `jti` do token. É o que a verificação confere contra a revogação.
  tokenId   String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String  @id
  accountId   String
  slug        String
  name        String
  description String
  /// JSON: Permission[]
  permissions Json
  isSystem    Boolean @default(false)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, slug])
}

// ---------------------------------------------------------------- etiquetas

model Label {
  id          String  @id
  accountId   String
  name        String
  tone        String
  description String?
  usageCount  Int?

  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts      Contact[]       @relation("ContactLabels")
  conversations Conversation[]  @relation("ConversationLabels")
  stages        PipelineStage[]

  @@index([accountId])
}

// ---------------------------------------------------------------- contatos

model Contact {
  id                   String    @id
  accountId            String
  name                 String
  /// E.164. Vazio quando `kind = grupo` — um grupo não tem telefone próprio.
  ///
  /// É o número por onde as conversas saem. Continua sendo **um**: uma conversa
  /// tem um destinatário, e escolher sozinho qual dos números usar seria decidir
  /// no lugar de quem atende.
  phone                String
  /// Outros números da mesma pessoa, em E.164, sem repetir o de `phone`.
  ///
  /// Nasce das importações de prospecção, onde a mesma pessoa aparece em várias
  /// linhas — uma por telefone. Guardar cada linha como um contato separado
  /// criava três "THIAGO FRANKLIN PROENCA" na agenda, e quem abrisse um deles
  /// não tinha como saber que os outros dois eram a mesma pessoa.
  extraPhones          String[]  @default([])
  email                String?
  /// Nome empresarial / razão social. A coluna física usa o nome pedido
  /// pelo formato B2B; `company` preserva o contrato existente do domínio/UI.
  company              String?   @map("empresa")
  cnpj                 String?
  companyAddress       String?   @map("endereco")
  companyPhone         String?   @map("telefone_empresa")
  partnerPhone         String?   @map("telefone_socio")
  classification       String?   @map("classificacao")
  /// JSON: ContactPartner[] — os sócios da empresa e os telefones de cada um,
  /// com a classificação de cada número.
  ///
  /// É JSON pela regra do topo deste arquivo: o agregado é lido e gravado
  /// inteiro, pela importação e pela tela que escolhe o destinatário, e
  /// nenhuma consulta filtra por sócio. Os números **também** ficam em `phone`
  /// e `extraPhones`, que são as colunas consultáveis: é por elas que a
  /// importação acha o contato já existente e que o envio valida o
  /// destinatário. A duplicação é deliberada, e cada lado responde uma pergunta
  /// diferente.
  partners             Json?     @map("socios")
  /// `manual`, `csv` ou `whatsapp`; separa a proveniência sem alterar `kind`.
  origin               String    @default("manual") @map("origem")
  channel              String
  avatarTone           String
  location             String?
  timezone             String?
  ownerName            String?
  lastContactAt        String?
  lastContactLabel     String?
  /// JSON: CustomField[]
  customFields         Json      @default("[]")
  notes                String?
  /// JSON: TimelineEvent[]
  timeline             Json      @default("[]")
  kind                 String?   @default("pessoa")
  avatarUrl            String?
  participantCount     Int?
  /// Pedido explicito para interromper mensagens de saida.
  whatsappOptOutAt     DateTime? @map("whatsapp_opt_out_at")
  whatsappOptOutReason String?   @map("whatsapp_opt_out_reason")
  /// Ultima autorizacao explicita posterior a um opt-out.
  whatsappOptInAt      DateTime? @map("whatsapp_opt_in_at")
  /// Id do usuário na API oficial do WhatsApp (BSUID), escopado ao portfólio.
  ///
  /// Desde abril de 2026 a Meta manda este id em todo webhook, e o telefone
  /// (`wa_id`) pode faltar: quem chega por nome de usuário sem conversa nos
  /// últimos 30 dias vem só com ele. Sem a coluna, esse cliente não teria como
  /// ser reconhecido na mensagem seguinte nem respondido.
  whatsappUserId       String?
  /// Quando o contato saiu da agenda sem levar o histórico junto.
  ///
  /// `Conversation.contactId` é obrigatório e cai em cascata: apagar a linha do
  /// contato apagava as conversas dele e, com elas, todas as mensagens. Quem
  /// exclui um contato da agenda está dizendo "não quero mais isto na minha
  /// lista", não "destrua o atendimento que já aconteceu" — e a segunda leitura
  /// era irreversível.
  ///
  /// Por isso a exclusão é em dois níveis: contato sem nenhuma conversa é
  /// apagado de verdade, porque não há nada a perder e a linha só viraria lixo;
  /// contato com histórico é marcado aqui e some das listas. Se a pessoa voltar
  /// a escrever, a marca é limpa — a conversa nova precisa de um contato
  /// visível para ser atendida.
  deletedAt            DateTime?

  account            Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  labels             Label[]                     @relation("ContactLabels")
  conversations      Conversation[]
  campaignRecipients CampaignRecipient[]
  importBatchEntries ContactImportBatchContact[]

  @@index([accountId])
  /// A agenda lista só os vivos, e é a consulta mais frequente da tela.
  @@index([accountId, deletedAt])
  @@index([accountId, whatsappOptOutAt])
  @@index([accountId, whatsappUserId])
}

/// Uma execução de importação CSV nomeada pelo usuário.
model ContactImportBatch {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  name      String   @map("nome")
  createdAt DateTime @default(now()) @map("created_at")

  account  Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts ContactImportBatchContact[]

  @@index([accountId, createdAt])
  @@map("contact_import_batches")
}

/// Relação explícita porque um contato pode reaparecer em importações futuras.
model ContactImportBatchContact {
  batchId   String   @map("batch_id")
  contactId String   @map("contact_id")
  rowNumber Int?     @map("row_number")
  createdAt DateTime @default(now()) @map("created_at")

  batch   ContactImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contact Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([batchId, contactId])
  @@index([contactId])
  @@map("contact_import_batch_contacts")
}

// ---------------------------------------------------------------- conversas

model Conversation {
  id                 String    @id
  accountId          String
  contactId          String
  channel            String
  inboxId            String
  queue              String
  status             String
  statusLabel        String
  /// Quando a conversa nasceu. É o início de toda janela de período do
  /// painel: sem ela, "últimos 7 dias" só conseguia contar a conversa pela
  /// última atividade -- uma conversa de março respondida ontem entrava como
  /// conversa de ontem.
  createdAt          DateTime  @default(now())
  /// Primeiro retorno de um atendente após a primeira mensagem do cliente.
  firstResponseAt    DateTime?
  /// O mesmo em segundos, já calculado. Guardado porque o painel agrega
  /// milhares de conversas por período e refazer a conta a cada leitura
  /// exigiria varrer a tabela de mensagens inteira.
  firstResponseSecs  Int?
  /// Quando passou a "resolvida" pela última vez.
  resolvedAt         DateTime?
  /// Da criação até a resolução, em segundos.
  resolutionSecs     Int?
  /// Nota de satisfação dada pelo cliente, de 1 a 5. Nulo = não avaliou.
  csatScore          Int?
  csatComment        String?
  /// Quando a pergunta de satisfação saiu -- a resposta seguinte do cliente
  /// é lida como nota enquanto esta marca estiver dentro da janela.
  csatAskedAt        DateTime?
  csatAnsweredAt     DateTime?
  priority           String    @default("baixa")
  assigneeId         String?
  assigneeName       String?
  unreadCount        Int       @default(0)
  lastMessagePreview String    @default("")
  /// Rótulo de exibição ("14:32"). Nunca use para ordenar.
  lastMessageAt      String    @default("")
  /// Instante real da última atividade — a única fonte de ordenação.
  lastActivityAt     DateTime?
  /// JSON: Protocol[]
  protocols          Json      @default("[]")
  slaDeadlineAt      String?
  slaLabel           String?
  slaBreached        Boolean?
  isTyping           Boolean?
  collisionAgent     String?
  lastInboundAt      String?
  channelOffline     Boolean?
  /// JID do WhatsApp. É o destino canônico de envio.
  channelThreadId    String?
  /// Criada pela importação silenciosa do histórico. Nunca é limpa.
  importedAt         DateTime?

  /// Ate quando o agente de IA fica fora desta conversa. Vazio = agente ativo.
  ///
  /// Um prazo, e nao um "sim/nao", porque os dois modos de pausar precisam
  /// terminar sozinhos: quem clica em "assumir" esquece de devolver, e a pausa
  /// que nasce de uma resposta pelo celular nao tem botao para desfaze-la. Com
  /// uma data, "ainda esta pausado?" e uma comparacao — nao ha runner varrendo
  /// conversa para reativar agente, nem estado que possa ficar preso.
  aiPausedUntil  DateTime?
  /// Quem pausou. Vazio quando a pausa foi automatica.
  ///
  /// Texto solto, e nao chave estrangeira para `User`, pelo mesmo motivo que
  /// `assigneeId` nao serve aqui: a pausa automatica nao tem autor nenhum.
  aiPausedBy     String?
  aiPausedByName String?
  /// `manual` (botao da tela) ou `resposta_no_celular` (deteccao automatica).
  aiPausedReason String?

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact           Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  inbox             Inbox              @relation(fields: [inboxId], references: [id], onDelete: Restrict)
  assignee          User?              @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  labels            Label[]            @relation("ConversationLabels")
  messages          Message[]
  scheduledMessages ScheduledMessage[]

  @@unique([inboxId, channelThreadId])
  @@index([accountId, lastActivityAt])
  /// O painel recorta por janela de tempo, sempre a partir da criação.
  @@index([accountId, createdAt])
  @@index([accountId, importedAt])
  /// A varredura da mensagem de espera procura por conversa parada em aberto.
  @@index([status, lastInboundAt])
  @@index([contactId])
}

model Message {
  id             String    @id
  conversationId String
  author         String
  /// Usuário do CRM que enviou a mensagem; nulo para contato/sistema.
  authorId       String?
  authorName     String?
  /// Tipo do conteúdo, duplicado fora do JSON para permitir consulta por mídia.
  contentType    String
  /// JSON: MessageContent
  content        Json
  /// Rótulo de exibição ("14:32").
  time           String
  /// Instante real. É daqui que saem os divisores de dia da timeline.
  createdAt      DateTime  @default(now())
  deliveryStatus String?
  isPrivate      Boolean   @default(false)
  /// Mensagem citada. Guarda o `Message.id`, não o id do canal: é por ele que a
  /// timeline encontra o original para desenhar a citação.
  replyToId      String?
  /// Quando a mensagem foi apagada. A linha continua: a timeline precisa do
  /// buraco no lugar certo ("Mensagem apagada"), como o próprio WhatsApp faz.
  /// Apagar a linha reordenaria o histórico e quebraria as citações que a
  /// apontam.
  deletedAt      DateTime?
  externalId     String?
  /// Dados do canal que não viram coluna: na API oficial, a categoria de cobrança
  /// (`pricing.category`) e se a mensagem foi cobrável, para o relatório de custo.
  channelMeta    Json?
  origin         String?
  /// JSON: MessageReaction[] — as reações (emoji) que esta mensagem recebeu.
  ///
  /// Coluna JSON e não tabela própria porque a reação não tem vida sem a
  /// mensagem: ela nasce, é substituída e morre junto, nunca é consultada
  /// isoladamente e o WhatsApp permite **uma** por pessoa. Uma tabela custaria
  /// um `join` em toda leitura de timeline para modelar um campo.
  reactions      Json      @default("[]")
  /// Ids dos usuários mencionados com `@` nesta nota interna.
  ///
  /// JSON: string[]. Coluna JSON pela regra do topo deste arquivo: a lista é
  /// lida e gravada inteira com a mensagem e nunca consultada sozinha.
  ///
  /// Extraída no servidor a partir do texto, e nunca recebida do cliente: quem
  /// enviasse a lista poderia notificar qualquer pessoa da conta sem escrever
  /// o nome dela em lugar nenhum.
  mentions       Json      @default("[]")
  /// JID de quem escreveu, quando a mensagem veio de um grupo.
  ///
  /// Fora de grupo é redundante (o autor é o dono da conversa) e fica nulo. Em
  /// grupo é indispensável para **reagir**: a chave que o WhatsApp exige para
  /// apontar uma mensagem de terceiro carrega o participante, e sem ele o
  /// servidor recusa a reação.
  senderJid      String?
  /// Chave estável de uma intenção automática. Nula para mensagens manuais.
  /// Impede dois runners/processos de criarem a mesma resposta automática.
  idempotencyKey String?   @unique
  /// Último erro operacional do despacho. O status continua próprio para filtro/UI.
  dispatchError  String?

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pendingMedia PendingMedia?

  /// Deduplicacao por construcao, e nao por sorte de agendamento.
  ///
  /// O WhatsApp reentrega eventos. Antes a checagem era consulta seguida de
  /// insercao -- duas operacoes com uma janela entre elas. A escrita serializada
  /// do SQLite escondia a corrida; em Postgres, dois eventos concorrentes viram
  /// mensagem duplicada na tela. Com o unico, o `upsert` resolve no banco.
  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([authorId])
  /// Recibo de entrega chega com o id do canal e mais nada.
  ///
  /// `applyDeliveryUpdate` procura por `externalId` sozinho, e o único índice
  /// que o continha era o composto com `conversationId` na frente — inútil para
  /// esta busca, porque o Postgres não consegue partir da segunda coluna. Cada
  /// recibo virava varredura da tabela inteira, e o WhatsApp manda um por
  /// mensagem entregue e outro por mensagem lida.
  @@index([externalId])
}

// ---------------------------------------------------------------- funil

model Pipeline {
  id          String  @id
  accountId   String
  name        String
  isDefault   Boolean @default(false)
  /// Mostra valores (R$) nos cards, colunas, resumo e formulários deste funil.
  ///
  /// Nem todo funil é de venda: um funil de suporte ou de matrícula não tem
  /// valor, e um "R$ 0,00" em cada card é ruído. Desligado, o valor gravado
  /// continua no banco e volta a aparecer ao religar.
  showAmounts Boolean @default(true)

  /// Vínculo legado entre funil e caixa de entrada.
  ///
  /// Funis novos pertencem à conta e deixam este campo nulo. Versões anteriores
  /// criavam um funil por conexão; a relação permanece apenas para preservar o
  /// histórico desses registros sem apagar oportunidades.
  ///
  /// `onDelete: SetNull` e não `Cascade`: excluir uma conexão do WhatsApp já
  /// apaga conversas e mensagens daquela caixa, e levar junto o histórico
  /// comercial — negócios ganhos, valores fechados — seria uma perda de outra
  /// natureza, que ninguém pediu ao clicar em "excluir caixa". O funil vira
  /// avulso em vez de desaparecer.
  inboxId String?
  inbox   Inbox?  @relation(fields: [inboxId], references: [id], onDelete: SetNull)

  account Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stages  PipelineStage[]
  deals   Deal[]

  @@index([accountId])
  @@index([inboxId])
}

model PipelineStage {
  id               String  @id
  pipelineId       String
  name             String
  order            Int
  color            String
  isWon            Boolean @default(false)
  isLost           Boolean @default(false)
  /// Quanto esta etapa representa de conversão, de 0 a 100.
  conversionWeight Int     @default(0)
  /// Etiqueta que representa esta etapa no cadastro do contato.
  ///
  /// É o elo entre o funil e as etiquetas: arrastar um card para cá aplica
  /// esta etiqueta ao contato e tira a da etapa de origem, e um contato que
  /// perde a última etiqueta ligada a alguma etapa sai do quadro. Nulo quando
  /// a etapa não espelha etiqueta nenhuma — o card então só se move na mão.
  labelId          String?

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  label    Label?   @relation(fields: [labelId], references: [id], onDelete: SetNull)
  deals    Deal[]

  @@index([pipelineId])
  @@index([labelId])
}

model Deal {
  id             String   @id
  accountId      String
  pipelineId     String
  stageId        String
  contactId      String?
  contactName    String
  company        String?
  /// Como a oportunidade se chama no quadro. Nulo cai em `contactName`.
  ///
  /// A modal de nova oportunidade sempre pediu este campo, e ele morria no
  /// caminho: o repositório o usava para compor o texto do histórico e para
  /// preencher `contactName` quando não havia contato, e nunca o gravava. A
  /// busca do Kanban procurava por `deal.title`, um campo que jamais existiu.
  title          String?
  /// De onde o negócio veio (`DealSource`). Nulo = não declarada.
  ///
  /// O `<select>` de origem existia na modal e na barra de filtros desde
  /// sempre; sem coluna, o filtro não casava com card nenhum.
  source         String?
  /// Centavos. Dinheiro nunca é float.
  amountInCents  Int
  ownerName      String
  priority       String   @default("baixa")
  /// Quando o card nasceu.
  ///
  /// Distinto de `enteredStageAt`, que é a entrada na **etapa atual** e muda a
  /// cada arrasto. Sem esta coluna, o filtro "Criados hoje" do quadro respondia
  /// pela data do último movimento — um card de março movido hoje entrava como
  /// criado hoje.
  createdAt      DateTime @default(now())
  enteredStageAt String
  stageAgeLabel  String
  nextAction     String
  conversationId String?
  /// JSON: DealHistoryEntry[]
  history        Json     @default("[]")
  /// Exibir o valor deste card. Nulo = segue o funil (`Pipeline.showAmounts`).
  ///
  /// É a exceção por card: o funil liga/desliga o valor para todos, e este
  /// campo permite um card específico discordar (ex.: um lead cujo valor
  /// ainda não foi negociado, num funil que normalmente mostra valores).
  showAmount     Boolean?

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([accountId, pipelineId])
  @@index([stageId])
  /// O filtro de período do quadro recorta por criação, dentro da conta.
  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------- agentes de IA

model AiAgent {
  id            String  @id
  accountId     String
  name          String
  scope         String
  active        Boolean @default(false)
  persona       String
  systemPrompt  String
  model         String
  handledCount  Int     @default(0)
  transferRate  String
  /// JSON: KnowledgeDocument[]
  knowledgeBase Json    @default("[]")
  /// JSON: TransferRule[]
  transferRules Json    @default("[]")
  /// JSON: AgentFlowBlock[]
  flow          Json    @default("[]")
  /// JSON: AiAgentLog[]
  logs          Json    @default("[]")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ---------------------------------------------------------------- notificações

model Notification {
  id        String   @id
  accountId String
  /// Nulo = aviso da conta inteira, visível para todos os agentes.
  userId    String?
  kind      String
  text      String
  timeLabel String
  read      Boolean  @default(false)
  href      String?
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, userId])
}

// ---------------------------------------------------------------- configurações

model Automation {
  id             String  @id
  accountId      String
  name           String
  trigger        String
  /// JSON: AutomationCondition[]
  conditions     Json    @default("[]")
  /// Como as condições se combinam: `e` (todas) ou `ou` (qualquer uma).
  /// O padrão repete o comportamento anterior ao campo, quando a lista era
  /// sempre avaliada com `every`.
  conditionLogic String  @default("e")
  /// JSON: AutomationAction[]
  actions        Json    @default("[]")
  enabled        Boolean @default(true)
  /// Decide quem vence um conflito de sobrescrita.
  order          Int

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, order])
}

model Inbox {
  id                         String  @id
  accountId                  String
  name                       String
  channel                    String
  identifier                 String
  status                     String
  provider                   String
  teamName                   String?
  /// JSON: BusinessHours
  businessHours              Json
  /// JSON: AgentSchedule. Quando o agente de IA atende esta caixa; fora dele o
  /// webhook não é disparado. Nulo = o agente atende a qualquer hora.
  aiAgentSchedule            Json?
  /// Sem uso: a mensagem fora do expediente foi removida do produto. A coluna
  /// fica para não apagar o texto que cada caixa tinha; nada mais a lê nem a
  /// grava, e pode sair numa migração futura.
  awayMessage                Json    @default("{}")
  /// JSON: AutoReply
  greeting                   Json
  /// JSON: AutoReply
  closingMessage             Json?
  /// JSON: AutoReply
  waitingMessage             Json?
  /// Minutos de fila sem resposta antes de a mensagem de espera sair.
  waitingMessageDelayMinutes Int     @default(5)
  /// Minutos de pausa quando o atendente responde pelo app do WhatsApp.
  ///
  /// Curto de proposito: aqui a pausa e um palpite do sistema, e nao a decisao
  /// de alguem. Errar para menos devolve o agente cedo demais uma vez; errar
  /// para mais deixa o cliente sem resposta sem ninguem ter pedido isso.
  aiPauseChannelReplyMinutes Int     @default(10)
  /// Pergunta a nota de 1 a 5 ao cliente quando o atendimento é encerrado.
  csatEnabled                Boolean @default(false)
  csatQuestion               String?
  webhookUrl                 String?

  account           Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  waConnection      WhatsAppConnection?
  cloudConnection   WhatsAppCloudConnection?
  campaigns         Campaign[]
  mediaObjects      MediaObject[]
  pendingMedia      PendingMedia[]
  addressBookNames  WhatsAppAddressBookName[]
  teamInboxes       TeamInbox[]
  pipelines         Pipeline[]
  whatsappCommands  WhatsAppCommand[]
  webhookScopes     WebhookInbox[]
  webhookDeliveries WebhookDelivery[]

  @@index([accountId])
}

/// Conexão de uma caixa com a API oficial do WhatsApp (Cloud API da Meta).
///
/// Tabela própria, e não colunas em `WhatsAppConnection`: aquela é o estado de
/// uma sessão Baileys (credenciais Signal, chaves, trava de worker), e nada dela
/// se aplica a um número que fala por HTTPS com a Meta.
model WhatsAppCloudConnection {
  inboxId            String    @id
  accountId          String
  /// manual | embedded_signup
  mode               String
  coexistence        Boolean   @default(false)
  businessId         String?
  wabaId             String
  phoneNumberId      String    @unique
  displayPhoneNumber String
  verifiedName       String?
  qualityRating      String?
  messagingLimit     String?
  /// conectando | pendente_registro | conectado | erro | desconectado
  status             String    @default("conectando")
  lastError          String?
  tokenCipher        Bytes
  tokenIv            Bytes
  tokenTag           Bytes
  tokenKeyId         String?
  /// Só no modo manual: o app é da empresa, e o secret dela assina o webhook.
  appId              String?
  appSecretCipher    Bytes?
  appSecretIv        Bytes?
  appSecretTag       Bytes?
  appSecretKeyId     String?
  pinCipher          Bytes?
  pinIv              Bytes?
  pinTag             Bytes?
  pinKeyId           String?
  /// Segmento da URL do webhook no modo manual. Aleatório, nunca o id da caixa.
  webhookKey         String    @unique
  /// SHA-256 do verify token. O token em si só aparece na tela ao ser gerado.
  verifyTokenHash    String
  subscribedAt       DateTime?
  registeredAt       DateTime?
  contactsSyncAt     DateTime?
  historySyncAt      DateTime?
  lastWebhookAt      DateTime?
  connectedByUserId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  inbox   Inbox   @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Evento recebido do webhook da Meta, gravado cru antes de ser processado.
///
/// A rota só valida e grava: responder em menos de um segundo é o que evita a
/// Meta retentar por sete dias, e uma falha no processamento não perde nada.
model WhatsAppCloudEvent {
  id            String    @id @default(cuid())
  accountId     String?
  inboxId       String?
  phoneNumberId String
  /// message | status | echo | history | app_state_sync | template_status | account_update | quality | user_preferences | desconhecido
  kind          String
  /// kind:id[:status]. A Meta reentrega o mesmo evento, e a chave o absorve.
  dedupeKey     String    @unique
  /// Ordena os eventos de um mesmo contato: duas mensagens dele não podem ser
  /// gravadas fora de ordem.
  orderKey      String?
  payload       Json
  /// pending | processing | done | failed | ignored
  status        String    @default("pending")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now())
  leaseUntil    DateTime?
  workerId      String?
  error         String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, availableAt])
  @@index([inboxId, receivedAt])
  @@index([status, processedAt])
}

/// Estado de uma sessão Baileys. Existe por caixa de entrada, não por conta:
/// uma conta com três números tem três linhas aqui, cada uma com socket próprio.
model WhatsAppConnection {
  inboxId String @id

  /// JID do número pareado. Nulo até o QR ser lido.
  phoneJid           String?
  profileName        String?
  /// Quem do CRM pareou. É o dono operacional do canal.
  pairedByUserId     String?
  status             String    @default("desconectado")
  lastError          String?
  lastConnectedAt    DateTime?
  /// String do QR em pareamento.
  qrPayload          String?
  /// Codigo curto gerado pelo Baileys para pareamento por numero de telefone.
  pairingCode        String?
  qrExpiresAt        DateTime?
  /// Contador de tentativas — evita loop de reconexão infinito após ban.
  retryCount         Int       @default(0)
  /// A caixa deve ficar conectada? É a intenção, não o estado do socket: só um
  /// pedido explícito de conexão a liga, e desconectar ou uma recusa definitiva
  /// do WhatsApp (401, 403, substituição persistente) a desliga. O worker não
  /// restaura nem religa por conta própria uma caixa com `false`.
  autoConnect        Boolean   @default(true)
  /// Início da última sincronização manual da agenda. Também funciona como
  /// trava temporal contra cliques repetidos que forçariam novos app-state syncs.
  lastContactsSyncAt DateTime?

  /// Janela solicitada no último pareamento. Nulo ou zero não importa.
  historyImportDays      Int?
  historyImportCutoff    DateTime?
  historyImportStatus    String?
  historyImportStartedAt DateTime?
  historyImportEndedAt   DateTime?
  historyImportStats     Json?
  /// Dono do histórico. Não é apagado no logout.
  historyOwnerPhoneJid   String?

  /// `creds.json` do Baileys, cifrado com AES-256-GCM.
  credsCipher Bytes?
  credsIv     Bytes?
  credsTag    Bytes?

  /// Trava de posse: só o worker que gravou este id pode abrir o socket.
  lockOwner     String?
  lockExpiresAt DateTime?
  /// Token monotônico de fencing. Cada nova posse incrementa o valor.
  lockVersion   Int       @default(0)
  /// Identifica a chave que cifrou as credenciais, permitindo rotação.
  credsKeyId    String?

  updatedAt DateTime @updatedAt

  inbox Inbox         @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  keys  WhatsAppKey[]
}

/// Referência cifrada para materializar mídia histórica somente quando solicitada.
model PendingMedia {
  messageId String   @id
  accountId String
  inboxId   String
  kind      String
  mimeType  String
  sizeBytes Int
  cipher    Bytes
  iv        Bytes
  tag       Bytes
  keyId     String?
  status    String   @default("pendente")
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inbox   Inbox   @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([accountId, inboxId, status])
}

/// Nome salvo na agenda do celular pareado, por contato.
///
/// Existe porque a agenda chega do WhatsApp só no pareamento e em alterações
/// feitas no celular, e vivia apenas na memória do worker: cada reinício a
/// apagava e o nome do perfil voltava a vencer. Não é o cadastro de contatos
/// e nada o exibe; ver `wa-address-book.ts`.
model WhatsAppAddressBookName {
  accountId String
  inboxId   String
  /// Número pareado dono desta agenda. Outro número na mesma caixa não a herda.
  ownerJid  String
  /// Contato, normalizado como a sessão guarda na memória.
  jid       String
  name      String
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inbox   Inbox   @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@id([inboxId, ownerJid, jid])
  @@index([accountId])
}

/// Material criptográfico de sessão. Milhares de linhas pequenas por conexão,
/// gravadas em lote. Separado de `WhatsAppConnection` porque o perfil de escrita
/// é o oposto: `creds` é raro e crítico; isto é frequente e reconstituível.
model WhatsAppKey {
  inboxId  String
  /// pre-key | session | sender-key | app-state-sync-key | app-state-sync-version | sender-key-memory
  category String
  keyId    String

  valueCipher     Bytes
  valueIv         Bytes
  valueTag        Bytes
  /// Identifica a chave que cifrou esta linha, permitindo rotação.
  encryptionKeyId String?

  updatedAt DateTime @updatedAt

  connection WhatsAppConnection @relation(fields: [inboxId], references: [inboxId], onDelete: Cascade)

  @@id([inboxId, category, keyId])
  @@index([inboxId, category])
  /// Expiração do material de cache (`lid-mapping`, `tctoken`).
  ///
  /// A faxina horária procura por categoria e idade, e o índice acima começa
  /// por `inboxId` — inútil para essa varredura. Sem este, a limpeza leria a
  /// tabela inteira a cada hora, e ela é justamente a que mais cresce.
  @@index([category, updatedAt])
}

/// Fila de comandos assíncronos enviados pelo Next.js para o Worker de WhatsApp.
model WhatsAppCommand {
  id             String    @id @default(cuid())
  sequence       BigInt    @unique @default(autoincrement())
  inboxId        String
  kind           String // connect | disconnect | send | read
  payload        Json      @default("{}")
  status         String    @default("pending") // pending | processing | completed | failed
  error          String?
  /// Quantas vezes o comando voltou para a fila por sessão fora do ar.
  /// É o que dá um teto à retentativa: sem ele, uma caixa desconectada de vez
  /// faria o mesmo envio circular entre `pending` e `processing` para sempre.
  attempts       Int       @default(0)
  /// Processo que reivindicou o comando e janela durante a qual a posse vale.
  workerId       String?
  claimedAt      DateTime?
  leaseUntil     DateTime?
  /// Instante mínimo para nova tentativa; evita retry em laço apertado.
  availableAt    DateTime  @default(now())
  /// Comando efêmero (presença) não deve executar depois deste instante.
  expiresAt      DateTime?
  /// Resultado persistido para diagnóstico e integrações.
  result         Json?
  /// Uma intenção durável por mensagem/ação idempotente.
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([inboxId, status])
  @@index([status, availableAt, createdAt])
  @@index([status, leaseUntil])
}

model KnowledgeCategory {
  id          String @id
  accountId   String
  name        String
  description String
  order       Int

  account  Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  articles KnowledgeArticle[]

  @@index([accountId])
}

model KnowledgeArticle {
  id           String @id
  accountId    String
  categoryId   String
  title        String
  slug         String
  excerpt      String
  content      String
  status       String
  updatedLabel String
  authorName   String
  views        Int    @default(0)
  helpful      Int    @default(0)
  notHelpful   Int    @default(0)
  /// JSON: string[]
  tags         Json   @default("[]")

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([accountId, categoryId])
}

/// Configurações gerais da conta.
model AccountSettings {
  accountId        String @id
  assignmentMethod String @default("round_robin")
  /// JSON: BillingInfo
  billing          Json
  /// JSON: ActiveSession[]
  activeSessions   Json   @default("[]")
  /// JSON: CompanyProfile — razão social, endereço, preferências regionais e marca.
  ///
  /// É JSON pela regra do topo deste arquivo: o perfil é lido e gravado
  /// inteiro pela tela de empresa, e nenhuma consulta filtra por endereço ou
  /// formato de data. `name` e `document` continuam colunas de `Account`,
  /// porque esses dois são consultados de fato.
  company          Json   @default("{}")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- Onda 3: Entidades Relacionais Normalizadas

model Team {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  description String?
  color       String
  createdAt   DateTime @default(now())

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  teamMembers TeamMember[]
  teamInboxes TeamInbox[]

  @@index([accountId])
}

/// Pessoa que pertence a uma equipe.
///
/// Substituiu dois campos `Json` que guardavam a mesma relação em direções
/// opostas: `Team.members` (ids de usuário) e `Membership.teams` (nomes de
/// equipe). Duas fontes para o mesmo fato saem de sincronia — atualiza-se uma e
/// esquece-se a outra —, e quando o fato é "quem alcança esta caixa de
/// entrada", sair de sincronia significa mostrar conversa de cliente para quem
/// não deveria vê-la.
///
/// Sem `accountId` de propósito: o vínculo é escopado pelo `Team`, que já o tem.
/// Duplicá-lo aqui criaria uma terceira cópia do mesmo fato — exatamente o que
/// esta tabela existe para eliminar.
model TeamMember {
  teamId String
  userId String

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

/// Caixa de entrada que uma equipe alcança.
///
/// É a tabela que decide o que cada pessoa enxerga na caixa de entrada. Uma
/// caixa pode pertencer a várias equipes (a recepção e a gerência veem
/// "Atendimento"), e uma pessoa em várias equipes enxerga a união das caixas.
model TeamInbox {
  teamId  String
  inboxId String

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@id([teamId, inboxId])
  @@index([inboxId])
}

model Webhook {
  id              String    @id @default(cuid())
  accountId       String
  name            String
  url             String
  /// JSON: string[] (eventos escutados)
  events          Json      @default("[]")
  secret          String?
  isActive        Boolean   @default(true)
  failureCount    Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  /// true = recebe de todas as caixas atuais e futuras; false = somente WebhookInbox.
  allInboxes      Boolean   @default(true)

  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
  inboxes    WebhookInbox[]

  @@index([accountId])
}

/// Caixas autorizadas a criar entregas para um webhook com allInboxes=false.
model WebhookInbox {
  webhookId String
  inboxId   String

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  inbox   Inbox   @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@id([webhookId, inboxId])
  @@index([inboxId])
}

/// Outbox durável de webhooks. A mensagem não espera o n8n responder e uma
/// indisponibilidade temporária não perde o evento.
model WebhookDelivery {
  id          String    @id @default(cuid())
  sequence    BigInt    @unique @default(autoincrement())
  webhookId   String
  accountId   String
  inboxId     String?
  event       String
  payload     Json
  dedupeKey   String
  status      String    @default("pending") // pending | processing | delivered | failed | canceled
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  workerId    String?
  claimedAt   DateTime?
  leaseUntil  DateTime?
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inbox   Inbox?  @relation(fields: [inboxId], references: [id], onDelete: SetNull)

  @@unique([webhookId, dedupeKey])
  @@index([status, availableAt, createdAt])
  @@index([status, leaseUntil])
  @@index([accountId, createdAt])
  @@index([webhookId, inboxId, status])
}

/// Evento-fonte gravado na mesma transação da mensagem. O runner transforma
/// esta intenção em uma WebhookDelivery para cada destino inscrito.
model WebhookEventOutbox {
  id          String    @id @default(cuid())
  sequence    BigInt    @unique @default(autoincrement())
  accountId   String
  inboxId     String?
  event       String
  payload     Json
  dedupeKey   String    @unique
  status      String    @default("pending") // pending | processing | completed | failed
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  workerId    String?
  claimedAt   DateTime?
  leaseUntil  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt, sequence])
  @@index([status, leaseUntil])
  @@index([accountId, sequence])
}

/// Liderança com prazo para tarefas globais (agendamentos, SLA, espera, retenção).
model BackgroundLease {
  name       String   @id
  owner      String
  version    Int      @default(1)
  leaseUntil DateTime
  updatedAt  DateTime @updatedAt
}

model ApiToken {
  id          String    @id @default(cuid())
  accountId   String
  name        String
  /// SHA-256 do token
  tokenHash   String    @unique
  tokenPrefix String
  /// JSON: string[] (permissões concedidas)
  permissions Json      @default("[]")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model CustomAttributeDefinition {
  id         String   @id @default(cuid())
  accountId  String
  /// contact | deal
  target     String
  name       String
  key        String
  /// text | number | select | date | boolean
  type       String
  /// JSON: string[] (opções para tipo select)
  options    Json     @default("[]")
  isRequired Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, target, key])
  @@index([accountId, target])
}

model CannedResponse {
  id         String   @id @default(cuid())
  accountId  String
  shortcut   String
  content    String
  category   String?
  /// JSON: string[]
  tags       Json     @default("[]")
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, shortcut])
  @@index([accountId])
}

model Macro {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  description String?
  category    String?
  shortcut    String?
  /// JSON: MacroAction[]
  actions     Json     @default("[]")
  createdAt   DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model AuditLogEntry {
  id         String   @id @default(cuid())
  accountId  String
  actorId    String
  actorName  String
  action     String
  targetType String
  targetId   String?
  targetName String?
  ip         String?
  userAgent  String?
  /// JSON: metadata
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([createdAt])
  @@index([accountId, action, createdAt])
}

/// Disparo de um template aprovado da API oficial para uma lista de contatos.
///
/// Só caixas da API oficial: o disparo em massa por QR Code é o uso que o
/// WhatsApp bane, e o template aprovado é o único jeito de falar com quem não
/// escreveu nas últimas 24 h.
model Campaign {
  id          String    @id @default(cuid())
  accountId   String
  inboxId     String
  name        String
  channel     String
  /// rascunho | agendada | em_andamento | pausada | concluida | cancelada
  status      String    @default("rascunho")
  segmentId   String?
  templateId  String?
  /// JSON: CampaignAudience — de onde saíram os destinatários (lista importada,
  /// etiqueta ou base inteira). Guardado para a tela explicar a campanha depois.
  audience    Json      @default("{}")
  /// JSON: CampaignVariable[] — de onde sai cada `{{n}}` do template: texto
  /// fixo ou um campo do contato.
  variables   Json      @default("[]")
  /// Envios por minuto. O executor dosa a fila por ele.
  rateLimit   Int       @default(30)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  canceledAt  DateTime?
  /// Último erro que parou a campanha (token inválido, conta bloqueada).
  lastError   String?
  createdById String?
  /// JSON: CampaignStats
  stats       Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inbox      Inbox               @relation(fields: [inboxId], references: [id], onDelete: Restrict)
  segment    Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  template   MessageTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([accountId, status])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  contactId   String?
  phone       String
  name        String?
  /// JSON: variables
  variables   Json      @default("{}")
  /// queued | sending | sent | delivered | read | replied | failed
  status      String    @default("queued")
  externalId  String?
  error       String?
  /// Conversa em que o template foi gravado, para a tela levar até ela.
  conversationId String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  repliedAt   DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([externalId])
  @@index([phone, status])
}

model Segment {
  id           String   @id @default(cuid())
  accountId    String
  name         String
  description  String?
  /// JSON: SegmentFilter[]
  filters      Json     @default("[]")
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([accountId])
}

/// Mensagem escrita agora para sair depois.
///
/// Vive numa tabela própria — e não como uma `Message` com data futura — porque
/// enquanto não sai ela **não é** uma mensagem: não aparece na timeline, não
/// conta como não lida, não entra no resumo da conversa e pode ser cancelada
/// sem deixar buraco. Gravá-la junto das outras obrigaria toda leitura de
/// conversa a lembrar de filtrar o futuro, e a primeira que esquecesse mostraria
/// ao operador uma mensagem que o cliente nunca recebeu.
///
/// Quem executa é o mesmo processo que fala com o WhatsApp (ver
/// `scheduled-runner.ts`): o disparo precisa de um processo vivo com relógio, e
/// no serverless não existe nenhum.
model ScheduledMessage {
  id             String    @id @default(cuid())
  accountId      String
  conversationId String
  /// Caixa **da conversa** no momento do agendamento. O envio sai por ela.
  inboxId        String
  /// Quem agendou — é o autor que a mensagem terá quando sair.
  userId         String
  userName       String
  text           String
  isPrivate      Boolean   @default(false)
  /// Mensagem citada, quando o agendamento nasceu de uma resposta.
  replyToId      String?
  scheduledFor   DateTime
  /// pending | sent | canceled | failed
  status         String    @default("pending")
  error          String?
  /// Id da `Message` criada quando o agendamento saiu.
  messageId      String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  workerId       String?
  claimedAt      DateTime?
  leaseUntil     DateTime?

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// O varredor pergunta sempre a mesma coisa: o que está pendente e já venceu.
  @@index([status, scheduledFor])
  @@index([conversationId, status])
  @@index([accountId, status])
  @@index([status, leaseUntil])
}

model MessageTemplate {
  id                 String   @id @default(cuid())
  accountId          String
  name               String
  category           String
  language           String   @default("pt_BR")
  body               String
  headerType         String?
  headerContent      String?
  footer             String?
  /// JSON: TemplateButton[]
  buttons            Json     @default("[]")
  /// JSON: string[]
  variables          Json     @default("[]")
  /// approved | rejected | pending
  status             String   @default("approved")
  externalTemplateId String?
  /// WABA de onde o template veio. Nulo nos criados só no CRM.
  wabaId             String?
  /// Motivo da recusa informado pela Meta.
  rejectedReason     String?
  createdAt          DateTime @default(now())

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([accountId, name, language])
  @@index([accountId])
  @@index([accountId, wabaId])
}

/// Tabela sem uso desde que o acesso passou a ser criado pelo gestor.
///
/// O convite por link foi substituído: o gestor cria a conta do colaborador
/// com e-mail e senha, e pode trocar as duas depois (ver
/// `createCollaboratorAction`). O modelo continua aqui porque derrubá-lo é uma
/// migração destrutiva sem nada a ganhar — a tabela está vazia e não custa
/// nada. Se um fluxo de convite voltar, ele encontra o desenho pronto.
model Invite {
  id              String    @id @default(cuid())
  accountId       String
  email           String
  roleSlug        String
  /// JSON: string[] — equipes que o convidado assume ao aceitar. É aqui que o
  /// gestor decide, no momento do convite, quais caixas a pessoa vai alcançar.
  teamIds         Json      @default("[]")
  tokenHash       String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InviteCreator", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([email])
}

model Task {
  id          String    @id @default(cuid())
  accountId   String
  dealId      String?
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  assigneeId  String?
  priority    String    @default("media")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account  Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deal     Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([accountId, completed, dueDate])
  @@index([dealId])
}

model MediaObject {
  id         String   @id @default(cuid())
  accountId  String
  inboxId    String?
  blobId     String?
  bucketPath String
  mimeType   String
  fileName   String?
  sizeBytes  Int
  checksum   String?
  /// Identificador recebido do WhatsApp antes de receber o escopo do tenant.
  sourceId   String
  /// Inbox da mídia ou "account" para avatares sem inbox específica.
  scopeKey   String
  /// mensagem | avatar
  mediaKind  String
  createdAt  DateTime @default(now())

  account Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inbox   Inbox?     @relation(fields: [inboxId], references: [id], onDelete: SetNull)
  blob    MediaBlob? @relation(fields: [blobId], references: [id], onDelete: SetNull)

  @@unique([accountId, scopeKey, mediaKind, sourceId])
  @@index([accountId, createdAt])
  @@index([bucketPath])
  @@index([blobId])
}

model MediaBlob {
  id         String   @id @default(cuid())
  accountId  String
  /// SHA-256 (hex) dos bytes decifrados.
  checksum   String
  /// Mesmo formato de `MediaObject.bucketPath`: "{bucket}/{caminho}".
  bucketPath String   @unique
  /// Do primeiro upload. Serve à extensão e à rota por conteúdo; cada mensagem
  /// mantém o próprio `mimeType`/`fileName` em `MediaObject`.
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  objects MediaObject[]

  @@unique([accountId, checksum])
}
